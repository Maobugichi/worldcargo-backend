# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parcel_tracker

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Resend (email notifications)
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=updates@yourdomain.com

# Unsubscribe link signing (separate secret from JWT, smaller blast radius if leaked)
UNSUBSCRIBE_TOKEN_SECRET=replace-with-a-different-long-random-string

# This backend's own publicly reachable URL, used to build absolute links
# in emails (e.g. the unsubscribe link). Defaults to localhost:PORT if unset --
# fine for local dev, but set this explicitly once deployed.
PUBLIC_API_URL=http://localhost:4000
